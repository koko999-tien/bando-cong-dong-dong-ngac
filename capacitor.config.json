{
  "appId": "vn.resilience.atlas",
  "appName": "VN Resilience Atlas",
  "webDir": "dist-mobile",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "bando-antoan-vn.vercel.app",
      "bando-cong-dong-dong-ngac.vercel.app",
      "*.open-meteo.com",
      "*.tile.openstreetmap.org",
      "server.arcgisonline.com"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#090F1E",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon_config_sample",
      "iconColor": "#0F766E"
    }
  }
}
